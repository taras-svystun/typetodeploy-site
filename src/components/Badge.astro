---
export type BadgeStatus = 'fonctionnel' | 'teste' | 'en-cours' | 'phase-2' | 'a-valider';

interface Props {
	status: BadgeStatus;
	label: string;
}

const { status, label } = Astro.props;

const colorVar: Record<BadgeStatus, string> = {
	fonctionnel: 'var(--status-done)',
	teste: 'var(--status-done)',
	'en-cours': 'var(--status-doing)',
	'phase-2': 'var(--status-planned)',
	'a-valider': 'var(--status-hypo)',
};
---

<span class="badge" style={`--badge-color: ${colorVar[status]}`}>{label}</span>

<style>
	.badge {
		display: inline-block;
		font-size: var(--step--1);
		font-weight: 500;
		letter-spacing: 0.04em;
		padding: 4px 9px;
		border-radius: var(--radius);
		color: var(--badge-color);
		border: 1px solid var(--badge-color);
		background: color-mix(in srgb, var(--badge-color) 8%, transparent);
	}
</style>
