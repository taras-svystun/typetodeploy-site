---
import { getImage } from 'astro:assets';
import type { Dict } from '../i18n/fr';
import type { Lang } from '../i18n/utils';

import bot1Desktop from '../assets/demo/bot_1_v2.png';
import bot1Mobile from '../assets/demo/bot_1_phone.png';
import bot2Desktop from '../assets/demo/bot_2_v2.png';
import bot2Mobile from '../assets/demo/bot_2_phone.png';
import bot3Desktop from '../assets/demo/bot_3_v2.png';
import bot3Mobile from '../assets/demo/bot_3_phone.png';
import bot4Desktop from '../assets/demo/bot_4_v2.png';
import bot4Mobile from '../assets/demo/bot_4_phone.png';
import siteBeforeDesktop from '../assets/demo/site_before_v2.png';
import siteBeforeMobile from '../assets/demo/site_before_mobile_v2.png';
import siteAfterDesktop from '../assets/demo/site_after_v2.png';
import siteAfterMobile from '../assets/demo/site_after_mobile_v2.png';

interface Props {
	t: Dict;
	lang: Lang;
}

const { t, lang } = Astro.props;
const d = t.demo;

const homeHref = lang === 'fr' ? '/' : '/en/';
const COMMIT_URL = 'https://github.com/taras-svystun/taras-and-lisa/commit/5fec45d';
const LIVE_SITE = 'https://taras-and-lisa.com';

const rawSources = {
	bot1: { desktop: bot1Desktop, mobile: bot1Mobile },
	bot2: { desktop: bot2Desktop, mobile: bot2Mobile },
	bot3: { desktop: bot3Desktop, mobile: bot3Mobile },
	bot4: { desktop: bot4Desktop, mobile: bot4Mobile },
	siteBefore: { desktop: siteBeforeDesktop, mobile: siteBeforeMobile },
	siteAfter: { desktop: siteAfterDesktop, mobile: siteAfterMobile },
} as const;

type ImageKey = keyof typeof rawSources;

const images = {} as Record<ImageKey, { desktop: Awaited<ReturnType<typeof getImage>>; mobile: Awaited<ReturnType<typeof getImage>> }>;
for (const key of Object.keys(rawSources) as ImageKey[]) {
	const { desktop, mobile } = rawSources[key];
	images[key] = {
		desktop: await getImage({ src: desktop, format: 'webp' }),
		mobile: await getImage({ src: mobile, format: 'webp' }),
	};
}
---

<section class="intro">
	<div class="container">
		<a href={homeHref} class="back-link">{d.topBackLink}</a>
		<h1>{d.h1}</h1>
		<p class="lead">{d.lead}</p>

		<div class="video-wrap">
			<div class="video-frame">
				<video id="demo-video" src="/media/demo.mp4" poster="/media/demo-poster.jpg" muted loop playsinline preload="metadata" controls></video>
			</div>
			<p class="caption">{d.video.caption}</p>
		</div>

		<div class="verification">
			<div class="verification-label">{d.verification.label}</div>
			<h2>{d.verification.heading}</h2>
			<div class="verification-cta">
				<a href={COMMIT_URL} target="_blank" rel="noopener" class="cta-primary">{d.verification.commitCta}</a>
				<a href={LIVE_SITE} target="_blank" rel="noopener" class="cta-secondary">{d.verification.siteCta}</a>
			</div>
			<div class="verification-trace">
				<span>{d.verification.commitLine1}</span>
				<span>{d.verification.commitLine2}</span>
			</div>
		</div>
	</div>
</section>

<section class="steps">
	<div class="container">
		<h2>{d.steps.h2}</h2>
		<p class="lead">{d.steps.lead}</p>

		<ol class="step-list">
			{
				d.steps.rows.map((row, i) => {
					const img = images[row.image as ImageKey];
					return (
						<li class:list={['step-row', i % 2 === 1 && 'step-row--reverse']}>
							<div class="step-heading">
								<div class="step-num">{row.num}</div>
								<h3>{row.title}</h3>
							</div>
							<div class="step-media">
								<picture>
									<source media="(max-width: 700px)" srcset={img.mobile.src} width={img.mobile.attributes.width} height={img.mobile.attributes.height} />
									<img
										src={img.desktop.src}
										width={img.desktop.attributes.width}
										height={img.desktop.attributes.height}
										alt={row.alt}
										loading={i === 0 ? 'eager' : 'lazy'}
										decoding="async"
									/>
								</picture>
							</div>
							<div class="step-fields">
								{row.fields.map((field) => (
									<>
										<div class="field-label">{d.steps.labels[field.label as keyof typeof d.steps.labels]}</div>
										{field.mono ? (
											<div class="field-mono">{field.value}</div>
										) : field.label === 'trace' ? (
											<p class="field-trace">{field.value}</p>
										) : (
											<p class={field.muted ? 'field-muted' : 'field-value'}>{field.value}</p>
										)}
									</>
								))}
							</div>
						</li>
					);
				})
			}
		</ol>
	</div>
</section>

<section class="limits">
	<div class="container">
		<h2>{d.limits.h2}</h2>
		<p class="lead">{d.limits.lead}</p>
		<ul class="limits-list">
			{d.limits.items.map((item) => <li>{item}</li>)}
		</ul>
	</div>
</section>

<section class="back">
	<div class="container">
		<p>{d.back.text}</p>
		<a href={homeHref} class="cta-primary">{d.back.cta}</a>
	</div>
</section>

<script>
	const video = document.getElementById('demo-video') as HTMLVideoElement | null;
	if (video && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		video.autoplay = true;
		video.play().catch(() => {});
	}
</script>

<style>
	.container {
		max-width: var(--width-page);
		margin: 0 auto;
		padding: 0 var(--s-6);
	}

	section {
		border-top: 1px solid var(--border);
	}

	.intro {
		border-top: none;
		background: var(--surface);
		padding: 72px 0 96px;
	}

	.steps {
		background: var(--surface-alt);
		padding: 72px 0;
	}

	.limits {
		background: var(--surface);
		padding: 72px 0;
	}

	.back {
		background: var(--surface-alt);
		padding: 64px 0;
	}

	h2 {
		font-size: var(--step-3);
		line-height: 1.2;
	}

	.lead {
		font-size: var(--step-1);
		line-height: 1.6;
		color: var(--ink-muted);
		max-width: var(--width-text);
		margin-top: 20px;
	}

	/* Intro */
	.back-link {
		display: inline-block;
		font-size: var(--step--0-5);
		padding: 13px 0;
		margin: -13px 0;
	}

	.intro h1 {
		font-size: var(--step-5);
		line-height: 1.08;
		letter-spacing: -0.015em;
		margin-top: 24px;
	}

	.video-wrap {
		max-width: 960px;
		margin-top: 48px;
	}

	.video-frame {
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		background: var(--ink);
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.video-frame video {
		width: 100%;
		height: 100%;
		object-fit: contain;
		background: var(--ink);
	}

	.caption {
		font-size: var(--step--1);
		color: var(--ink-muted);
		margin-top: 14px;
	}

	.verification {
		max-width: 960px;
		margin-top: 40px;
		background: var(--accent-soft);
		border: 1px solid var(--accent);
		border-radius: var(--radius);
		padding: 40px;
	}

	.verification-label {
		font-size: var(--step--1);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.verification h2 {
		font-size: var(--step-3);
		line-height: 1.25;
		font-weight: 600;
		margin-top: 16px;
		max-width: 40ch;
	}

	.verification-cta {
		display: flex;
		align-items: center;
		gap: var(--s-3);
		margin-top: 28px;
	}

	.cta-primary,
	.cta-secondary {
		font-size: 15px;
		font-weight: 500;
		border-radius: var(--radius);
		text-decoration: none;
	}

	.cta-primary {
		background: var(--accent);
		color: var(--surface);
		padding: 13px 22px;
	}

	.cta-primary:hover {
		background: var(--accent-hover);
	}

	.cta-secondary {
		background: var(--surface);
		color: var(--ink);
		border: 1px solid var(--border-strong);
		padding: 12px 21px;
	}

	.verification-trace {
		display: flex;
		gap: var(--s-6);
		margin-top: 28px;
		padding-top: 20px;
		border-top: 1px solid var(--border-strong);
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--ink-muted);
	}

	/* Steps */
	.step-list {
		display: flex;
		flex-direction: column;
	}

	.step-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-template-areas: 'media heading' 'media fields';
		align-content: center;
		column-gap: var(--s-12);
		margin-top: 40px;
		padding-top: 40px;
		border-top: 1px solid var(--border);
	}

	.step-row:first-child {
		margin-top: 56px;
		border-top-color: var(--border-strong);
	}

	.step-row--reverse {
		grid-template-areas: 'heading media' 'fields media';
	}

	.step-heading {
		grid-area: heading;
	}

	.step-fields {
		grid-area: fields;
	}

	.step-media {
		grid-area: media;
		align-self: center;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		background: var(--surface);
		padding: var(--s-2);
	}

	.step-media img {
		width: 100%;
		height: auto;
		border-radius: var(--radius-sm);
	}

	.step-num {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--ink-muted);
	}

	.step-heading h3 {
		font-size: var(--step-1);
		font-weight: 600;
		margin-top: 10px;
	}

	.field-label {
		font-size: var(--step--1);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-muted);
		margin-top: 20px;
		margin-bottom: 6px;
	}

	.field-mono {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 14px 16px;
		font-family: var(--font-mono);
		font-size: var(--step--1);
		line-height: 1.6;
		color: var(--ink);
		overflow-wrap: break-word;
	}

	.field-value {
		font-size: var(--step-0);
		line-height: 1.6;
		color: var(--ink);
	}

	.field-muted {
		font-size: var(--step-0);
		line-height: 1.6;
		color: var(--ink-muted);
	}

	.field-trace {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		line-height: 1.6;
		color: var(--ink-muted);
		overflow-wrap: break-word;
	}

	/* Limits */
	.limits-list {
		display: flex;
		flex-direction: column;
		margin-top: 32px;
		max-width: var(--width-text);
	}

	.limits-list li {
		border-top: 1px solid var(--border);
		padding: 18px 0;
		font-size: var(--step-0);
		line-height: 1.65;
		color: var(--ink);
	}

	.limits-list li:first-child {
		border-top-color: var(--border-strong);
	}

	.limits-list li:last-child {
		border-bottom: 1px solid var(--border);
	}

	/* Back */
	.back .container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 40px;
	}

	.back p {
		font-size: var(--step-1);
		line-height: 1.5;
		color: var(--ink);
		max-width: 52ch;
	}

	.back .cta-primary {
		flex: none;
	}

	@media (max-width: 700px) {
		.container {
			padding: 0 20px;
		}

		.intro {
			padding: 40px 0 56px;
		}

		.steps,
		.limits {
			padding: 64px 0;
		}

		.back {
			padding: 48px 0;
		}

		h2 {
			font-size: var(--step-2);
			line-height: 1.25;
		}

		.lead {
			font-size: var(--step-0);
			margin-top: var(--s-4);
		}

		.intro h1 {
			font-size: var(--step-3-5);
			line-height: 1.12;
			letter-spacing: -0.01em;
			margin-top: 18px;
		}

		.video-wrap {
			margin-top: 28px;
		}

		.caption {
			line-height: 1.55;
			margin-top: 12px;
		}

		.verification {
			margin-top: 24px;
			padding: 24px 20px;
		}

		.verification h2 {
			font-size: var(--step-2);
			line-height: 1.28;
			margin-top: 12px;
		}

		.verification-cta {
			flex-direction: column;
			align-items: stretch;
			gap: 10px;
			margin-top: 22px;
		}

		.cta-primary,
		.cta-secondary {
			display: block;
			text-align: center;
		}

		.cta-primary {
			padding: 15px 20px;
		}

		.cta-secondary {
			padding: 14px 19px;
		}

		.verification-trace {
			flex-direction: column;
			gap: 4px;
			margin-top: 22px;
			padding-top: 16px;
		}

		.step-row {
			grid-template-columns: 1fr;
			grid-template-areas: 'heading' 'media' 'fields';
			column-gap: 0;
			margin-top: 40px;
			padding-top: 28px;
		}

		.step-row:first-child {
			margin-top: 40px;
		}

		.step-media {
			padding: 6px;
			margin-top: 18px;
		}

		.step-heading h3 {
			font-size: var(--step-0-5);
			line-height: 1.35;
			margin-top: 8px;
		}

		.limits-list {
			margin-top: 28px;
		}

		.limits-list li {
			padding: 16px 0;
		}

		.back .container {
			flex-direction: column;
			align-items: stretch;
			gap: 20px;
		}

		.back .cta-primary {
			display: block;
			text-align: center;
		}
	}
</style>
