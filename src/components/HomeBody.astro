---
import Badge, { type BadgeStatus } from './Badge.astro';
import type { Dict } from '../i18n/fr';
import type { Lang } from '../i18n/utils';

interface Props {
	t: Dict;
	lang: Lang;
}

const { t, lang } = Astro.props;
const h = t.home;

const demoHref = lang === 'fr' ? '/demonstration' : '/en/demo';
const LIVE_SITE = 'https://taras-and-lisa.com';
const PRODUCT_REPO = 'https://github.com/taras-svystun/taras-and-lisa';
const SITE_REPO = 'https://github.com/taras-svystun/typetodeploy-site';
const EMAIL = 'contact@taras-and-lisa.com';
---

<section class="hero">
	<div class="container">
		<div class="eyebrow-row">
			<span class="eyebrow-rule"></span>
			<span class="eyebrow">{h.hero.eyebrow}</span>
		</div>
		<h1>{h.hero.h1}</h1>
		<p class="lead">{h.hero.lead}</p>
		<div class="cta-row">
			<a href={demoHref} class="cta-primary">{h.hero.ctaPrimary}</a>
			<a href={LIVE_SITE} target="_blank" rel="noopener" class="cta-secondary">{h.hero.ctaSecondary}</a>
		</div>
		<ul class="evidence">
			{
				h.hero.evidence.map((item) => (
					<li>
						<div class="evidence-title">{item.title}</div>
						<div class="evidence-text">{item.text}</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<section class="problem">
	<div class="container">
		<h2>{h.problem.h2}</h2>
		<div class="para-stack">
			{h.problem.paragraphs.map((p) => <p>{p}</p>)}
		</div>
		<div class="origin">
			<h3>{h.problem.origin.h3}</h3>
			{h.problem.origin.paragraphs.map((p) => <p>{p}</p>)}
		</div>
	</div>
</section>

<section class="solution">
	<div class="container">
		<h2>{h.solution.h2}</h2>
		<p class="lead">{h.solution.lead}</p>
		<ul class="steps">
			{
				h.solution.steps.map((step, i) => (
					<li>
						<div class="step-num">{i + 1}</div>
						<h3>{step.title}</h3>
						<p>{step.text}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<section class="demo-preview">
	<div class="container">
		<h2>{h.demoPreview.h2}</h2>
		<p class="lead">{h.demoPreview.lead}</p>
		<div class="poster-wrap">
			<a href={demoHref} class="poster-link">
				<img src="/media/demo-poster.jpg" alt={h.demoPreview.posterAlt} width="1600" height="1000" />
			</a>
			<a href={demoHref} class="poster-cta">{h.demoPreview.cta}</a>
		</div>
	</div>
</section>

<section class="status">
	<div class="container">
		<h2>{h.status.h2}</h2>
		<p class="lead">{h.status.lead}</p>
		<table class="status-table">
			<caption>{h.status.caption}</caption>
			<thead>
				<tr>
					<th scope="col">{h.status.colItem}</th>
					<th scope="col" class="col-state">{h.status.colState}</th>
				</tr>
			</thead>
			<tbody>
				{
					h.status.rows.map((row) => (
						<tr>
							<td>{row.label}</td>
							<td class="col-state" data-label={h.status.colState}>
								<Badge status={row.status as BadgeStatus} label={row.statusLabel} />
							</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</section>

<section class="technical">
	<div class="container">
		<h2>{h.technical.h2}</h2>
		<div class="para-stack">
			{h.technical.paragraphs.map((p) => <p>{p}</p>)}
		</div>
		<div class="example">
			<div class="example-label">{h.technical.exampleLabel}</div>
			<pre><code>{h.technical.scopeLine}
{h.technical.changedLine} → <span class="refused">{h.technical.refusedLabel}</span></code></pre>
		</div>
	</div>
</section>

<section class="hypotheses">
	<div class="container">
		<h2>{h.hypotheses.h2}</h2>
		<p class="lead">{h.hypotheses.lead}</p>
		<table class="hypotheses-table">
			<caption>{h.hypotheses.caption}</caption>
			<thead>
				<tr>
					<th scope="col">{h.hypotheses.colHypothesis}</th>
					<th scope="col">{h.hypotheses.colMethod}</th>
					<th scope="col">{h.hypotheses.colCriterion}</th>
				</tr>
			</thead>
			<tbody>
				{
					h.hypotheses.rows.map((row) => (
						<tr>
							<td>{row.hypothesis}</td>
							<td data-label={h.hypotheses.colMethod}>{row.method}</td>
							<td data-label={h.hypotheses.colCriterion}>{row.criterion}</td>
						</tr>
					))
				}
			</tbody>
		</table>
		<p class="note">{h.hypotheses.note}</p>
	</div>
</section>

<section class="phase2">
	<div class="container">
		<h2>{h.phase2.h2}</h2>
		<p class="lead">{h.phase2.lead}</p>
		<ul class="phase2-steps">
			{
				h.phase2.steps.map((step) => (
					<li>
						<div class="step-label">{step.label}</div>
						<p>{step.text}</p>
					</li>
				))
			}
		</ul>
		<p class="note">{h.phase2.closing}</p>
	</div>
</section>

<section class="impact">
	<div class="container">
		<h2>{h.impact.h2}</h2>
		<div class="para-stack">
			{h.impact.paragraphs.map((p) => <p>{p}</p>)}
		</div>
	</div>
</section>

<section class="team">
	<div class="container">
		<h2>{h.team.h2}</h2>
		<p class="lead">{h.team.lead}</p>
		<ul class="team-cards">
			{
				h.team.members.map((member) => (
					<li>
						<div class="member-role">{member.role}</div>
						<h3>
							<a href={member.linkedin} target="_blank" rel="noopener">
								{member.name}
							</a>
						</h3>
						{member.paragraphs.map((p) => (
							<p>{p}</p>
						))}
					</li>
				))
			}
		</ul>
		<p class="note">{h.team.closing}</p>
	</div>
</section>

<section class="support">
	<div class="container">
		<h2>{h.support.h2}</h2>
		<p class="lead">{h.support.lead}</p>
		<ul class="support-items">
			{h.support.items.map((item) => <li>{item}</li>)}
		</ul>
	</div>
</section>

<section class="contact">
	<div class="container">
		<h2>{h.contact.h2}</h2>
		<dl class="contact-list">
			<div class="contact-row">
				<dt>{h.contact.email}</dt>
				<dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
			</div>
			<div class="contact-row">
				<dt>{h.contact.liveSite}</dt>
				<dd>
					<a href={LIVE_SITE} target="_blank" rel="noopener">
						taras-and-lisa.com
					</a>
				</dd>
			</div>
			<div class="contact-row">
				<dt>{h.contact.productRepo}</dt>
				<dd>
					<a href={PRODUCT_REPO} target="_blank" rel="noopener">
						github.com/taras-svystun/taras-and-lisa
					</a>
				</dd>
			</div>
			<div class="contact-row">
				<dt>{h.contact.siteRepo}</dt>
				<dd>
					<a href={SITE_REPO} target="_blank" rel="noopener">
						github.com/taras-svystun/typetodeploy-site
					</a>
				</dd>
			</div>
			<div class="contact-row contact-row-last">
				<dt>{h.contact.linkedin}</dt>
				<dd class="linkedin-row">
					{
						h.team.members.map((member, i) => (
							<>
								{i > 0 && (
									<span class="dot" aria-hidden="true">
										·
									</span>
								)}
								<a href={member.linkedin} target="_blank" rel="noopener">
									{member.name}
								</a>
							</>
						))
					}
				</dd>
			</div>
		</dl>
	</div>
</section>

<style>
	.container {
		max-width: var(--width-page);
		margin: 0 auto;
		padding: 0 var(--s-6);
	}

	section {
		border-top: 1px solid var(--border);
	}

	.hero {
		border-top: none;
		background: var(--surface);
		padding: 96px 0 88px;
	}

	.problem,
	.solution,
	.demo-preview,
	.status {
		padding: 96px 0;
	}

	.technical,
	.hypotheses,
	.phase2,
	.impact,
	.team,
	.support,
	.contact {
		padding: var(--s-18) 0;
	}

	/* Sections alternate surface / surface-alt, starting with surface at the hero */
	.hero,
	.solution,
	.status,
	.hypotheses,
	.impact,
	.support {
		background: var(--surface);
	}

	.problem,
	.demo-preview,
	.technical,
	.phase2,
	.team,
	.contact {
		background: var(--surface-alt);
	}

	h2 {
		font-size: var(--step-3);
		line-height: 1.2;
	}

	.technical h2 {
		line-height: 1.25;
		max-width: 24ch;
	}

	.lead {
		font-size: var(--step-1);
		line-height: 1.6;
		color: var(--ink-muted);
		max-width: var(--width-text);
		margin-top: 20px;
	}

	.para-stack {
		display: flex;
		flex-direction: column;
		gap: 20px;
		margin-top: 28px;
		max-width: var(--width-text);
	}

	.para-stack p {
		margin: 0;
	}

	.technical .para-stack {
		margin-top: 32px;
	}

	.note {
		font-size: var(--step--0-5);
		color: var(--ink-muted);
		max-width: var(--width-text);
		margin-top: var(--s-6);
	}

	/* Hero */
	.eyebrow-row {
		display: flex;
		align-items: center;
		gap: var(--s-3);
	}

	.eyebrow-rule {
		display: block;
		width: 24px;
		height: 1px;
		background: var(--accent);
	}

	.eyebrow {
		font-size: var(--step--1);
		color: var(--ink-muted);
	}

	.hero h1 {
		font-size: var(--step-5);
		line-height: 1.08;
		letter-spacing: -0.015em;
		margin-top: 28px;
		max-width: 20ch;
	}

	.hero .lead {
		margin-top: var(--s-6);
	}

	.cta-row {
		display: flex;
		align-items: center;
		gap: var(--s-3);
		margin-top: 40px;
	}

	.cta-primary,
	.cta-secondary {
		font-size: 15px;
		font-weight: 500;
		border-radius: var(--radius);
		text-decoration: none;
	}

	.cta-primary {
		background: var(--accent);
		color: var(--surface);
		padding: 13px 22px;
	}

	.cta-primary:hover {
		background: var(--accent-hover);
	}

	.cta-secondary {
		background: var(--surface);
		color: var(--ink);
		border: 1px solid var(--border-strong);
		padding: 12px 21px;
	}

	.evidence {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 40px;
		margin-top: 56px;
		max-width: 900px;
	}

	.evidence li {
		border-top: 1px solid var(--border-strong);
		padding-top: 14px;
	}

	.evidence-title {
		font-size: var(--step--0-5);
		font-weight: 500;
		color: var(--ink);
	}

	.evidence-text {
		font-size: var(--step--1);
		line-height: 1.5;
		color: var(--ink-muted);
		margin-top: 4px;
	}

	/* Problem */
	.origin {
		margin-top: 48px;
		background: var(--accent-soft);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		padding: var(--s-8);
		max-width: var(--width-text);
	}

	.origin h3 {
		font-size: var(--step-1);
		color: var(--accent);
	}

	.origin p {
		margin-top: var(--s-4);
	}

	.origin p + p {
		margin-top: 16px;
	}

	/* Solution */
	.steps {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--s-8);
		margin-top: 56px;
	}

	.steps li {
		border-left: 1px solid var(--border);
		padding-left: var(--s-6);
	}

	.step-num {
		font-size: var(--step-1);
		font-weight: 600;
		color: var(--accent);
		line-height: 1;
	}

	.steps h3 {
		font-size: var(--step-0);
		margin-top: var(--s-4);
	}

	.steps p {
		font-size: var(--step--0-5);
		line-height: 1.6;
		color: var(--ink-muted);
		margin-top: 10px;
	}

	/* Demo preview */
	.poster-wrap {
		max-width: 960px;
		margin-top: 40px;
	}

	.poster-link {
		display: block;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--ink);
	}

	.poster-link:hover {
		border-color: var(--accent);
	}

	.poster-link img {
		display: block;
		width: 100%;
		height: auto;
	}

	.poster-cta {
		display: inline-block;
		font-size: var(--step--0-5);
		font-weight: 500;
		margin-top: 14px;
	}

	/* Tables shared */
	table {
		width: 100%;
		margin-top: 40px;
		font-size: var(--step--0-5);
	}

	caption {
		text-align: left;
		font-size: var(--step--1);
		color: var(--ink-muted);
		padding-bottom: 14px;
	}

	th {
		text-align: left;
		font-size: var(--step--1);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-muted);
		padding: 0 24px 12px 0;
		border-bottom: 1px solid var(--border-strong);
	}

	td {
		padding: 16px 24px 16px 0;
		border-bottom: 1px solid var(--border);
		color: var(--ink);
		line-height: 1.5;
	}

	/* Status table */
	.status-table {
		max-width: 900px;
	}

	.status-table .col-state {
		text-align: right;
		padding-right: 0;
	}

	.status-table th.col-state {
		width: 190px;
	}

	/* Hypotheses table */
	.hypotheses-table {
		table-layout: fixed;
	}

	.hypotheses-table th,
	.hypotheses-table td {
		vertical-align: top;
		line-height: 1.55;
	}

	.hypotheses-table td:not(:first-child) {
		color: var(--ink-muted);
	}

	.hypotheses-table th:nth-child(1),
	.hypotheses-table td:nth-child(1) {
		width: 36%;
	}

	.hypotheses-table th:nth-child(2),
	.hypotheses-table td:nth-child(2) {
		width: 32%;
	}

	.hypotheses-table th:last-child,
	.hypotheses-table td:last-child {
		width: 32%;
		padding-right: 0;
	}

	/* Technical */
	.example {
		margin-top: 36px;
		max-width: var(--width-text);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 20px 24px;
	}

	.example-label {
		font-size: var(--step--1);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-muted);
		margin-bottom: 14px;
	}

	.example pre {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		line-height: 1.9;
		color: var(--ink);
		white-space: pre-wrap;
		margin: 0;
	}

	.refused {
		color: var(--status-doing);
	}

	/* Phase 2 */
	.phase2-steps {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
		margin-top: 40px;
	}

	.phase2-steps li {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 28px;
	}

	.step-label {
		font-size: var(--step--1);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.phase2-steps p {
		font-size: var(--step-0);
		line-height: 1.6;
		color: var(--ink);
		margin-top: 14px;
	}

	/* Team */
	.team-cards {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--s-6);
		margin-top: 40px;
	}

	.team-cards li {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: var(--s-8);
	}

	.member-role {
		font-size: var(--step--1);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}

	.team-cards h3 {
		font-size: var(--step-1);
		margin-top: 12px;
	}

	.team-cards h3 a {
		display: inline-block;
		padding: 12px 16px;
		margin: -12px -16px;
	}

	.team-cards p {
		line-height: 1.65;
		margin-top: var(--s-4);
	}

	.team-cards p + p {
		margin-top: 14px;
	}

	/* Support */
	.support-items {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0 48px;
		margin-top: 40px;
		max-width: 960px;
	}

	.support-items li {
		border-top: 1px solid var(--border);
		padding: var(--s-6) 0;
		line-height: 1.65;
	}

	/* Contact */
	.contact-list {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 0;
		margin-top: 36px;
		max-width: 820px;
		font-size: var(--step-0);
	}

	.contact-row {
		display: contents;
	}

	.contact-row dt {
		border-top: 1px solid var(--border);
		padding: 18px 0;
		color: var(--ink-muted);
		font-weight: normal;
	}

	.contact-row dd {
		border-top: 1px solid var(--border);
		padding: 18px 0;
		margin: 0;
	}

	.contact-row:first-child dt,
	.contact-row:first-child dd {
		border-top-color: var(--border-strong);
	}

	.contact-row-last dt,
	.contact-row-last dd {
		border-bottom: 1px solid var(--border);
	}

	.linkedin-row {
		display: flex;
		gap: 20px;
	}

	.dot {
		color: var(--border-strong);
	}

	@media (max-width: 700px) {
		.container {
			padding: 0 20px;
		}

		.hero {
			padding: 56px 0 60px;
		}

		.problem,
		.demo-preview,
		.status,
		.technical,
		.hypotheses,
		.phase2,
		.impact,
		.team,
		.support,
		.contact {
			padding: 64px 0;
		}

		h2 {
			font-size: var(--step-2);
			line-height: 1.25;
		}

		.technical h2,
		.phase2 h2,
		.support h2 {
			line-height: 1.3;
			max-width: none;
		}

		.lead {
			font-size: var(--step-0);
			margin-top: var(--s-4);
		}

		.para-stack {
			gap: 16px;
			margin-top: 20px;
		}

		.technical .para-stack {
			margin-top: 22px;
		}

		.note {
			margin-top: 20px;
		}

		/* Hero */
		.eyebrow-row {
			align-items: flex-start;
			gap: 10px;
		}

		.eyebrow-rule {
			width: 20px;
			margin-top: 9px;
			flex: none;
		}

		.eyebrow {
			font-size: var(--step--1);
			line-height: 1.45;
		}

		.hero h1 {
			font-size: var(--step-3-5);
			line-height: 1.12;
			letter-spacing: -0.01em;
			margin-top: 20px;
			max-width: none;
		}

		.hero .lead {
			font-size: var(--step-0);
			margin-top: 18px;
		}

		.cta-row {
			flex-direction: column;
			align-items: stretch;
			gap: 10px;
			margin-top: 28px;
		}

		.cta-primary,
		.cta-secondary {
			display: block;
			text-align: center;
		}

		.cta-primary {
			padding: 15px 20px;
		}

		.cta-secondary {
			padding: 14px 19px;
		}

		.evidence {
			display: flex;
			flex-direction: column;
			gap: 0;
			margin-top: 32px;
			max-width: none;
		}

		.evidence li {
			border-top-color: var(--border);
			padding: 12px 0;
		}

		.evidence li:first-child {
