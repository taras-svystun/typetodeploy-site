---
import Layout from '../layouts/Layout.astro';
import DemoBody from '../components/DemoBody.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'fr';
const t = useTranslations(lang);
---

<Layout lang={lang} title={t.meta.demo.title} description={t.meta.demo.description} path="/demonstration">
	<DemoBody t={t} lang={lang} />
</Layout>
